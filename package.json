{
  "name": "@chopsticks/engine",
  "version": "0.1.0",
  "description": "Framework-free, deterministic rules engine for the Chopsticks hand game.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc --project tsconfig.build.json",
    "build:server": "tsc --project tsconfig.server.json",
    "clean": "rm -rf dist dist-server",
    "play": "tsx cli/main.ts",
    "web": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "serve": "tsx server/http.ts",
    "serve:prod": "node dist-server/server/http.js"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-native": "^0.72.8",
    "@types/ws": "^8.18.1",
    "react-native": "^0.86.2",
    "react-native-safe-area-context": "^5.9.0",
    "react-native-svg": "^15.15.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "ws": "^8.21.3"
  }
}
