{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "baseUrl": "..",
    "paths": {
      "@chopsticks/engine": ["./src/index.ts"],
      "@chopsticks/session": ["./session/session.ts"]
    }
  },
  "include": ["./**/*.ts", "./**/*.tsx", "../src/**/*.ts", "../session/**/*.ts", "../ai/**/*.ts"]
}