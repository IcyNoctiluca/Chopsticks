# Production runtime image for the Chopsticks match server.
# Builds the server once and runs the compiled artifact with Node.
# Dependencies from the manifests alone, so CI's build cache (`cache_stages`,
# Battlenet progress 0385) reuses this stage until they change; the source is
# copied in the stage below.
FROM node:25-slim AS deps

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm ci

FROM deps AS builder

COPY . .
RUN npm run build:server

FROM node:25-slim

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000

# Only the compiled server and runtime dependency manifest are needed.
COPY package.json package-lock.json* ./
RUN npm ci --omit=dev

COPY --from=builder /app/dist-server ./dist-server

EXPOSE 3000

CMD ["node", "dist-server/server/http.js"]
